{
  "name": "swasthasetu",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperlocal elderly-first doorstep diagnostics platform — caregiver, elder, field agent, partner lab and ops surfaces in one PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "demo:track": "tsx scripts/demo-track.ts",
    "provision:voice": "tsx scripts/provision-voice-agent.ts",
    "retention:purge": "tsx scripts/retention-purge.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elevenlabs/react": "1.15.1",
    "@prisma/client": "6.19.3",
    "@vis.gl/react-google-maps": "1.10.0",
    "date-fns": "4.4.0",
    "jose": "6.2.12",
    "next": "16.3.4",
    "razorpay": "2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
