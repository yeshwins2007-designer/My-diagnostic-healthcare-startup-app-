# SwasthaSetu configuration.
#
# Copy to .env.local and fill in what you have. EVERYTHING here is optional
# except DATABASE_URL: any integration without credentials runs against a
# working simulator instead, so the app is fully usable on a clean checkout.
# Adding a key switches that one integration to live. No code changes.

# --- required ---------------------------------------------------------------

DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma's datasource provider to
# "postgresql" and point this at your India-region database:
# DATABASE_URL="postgresql://user:pass@host:5432/swasthasetu?schema=public"

# --- security (required before serving production traffic) ------------------

# openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me"

# openssl rand -hex 32   — AES-256-GCM key for result values at rest.
# Without it, a key is derived from AUTH_SECRET so development works; the app
# refuses to start in production without a real one.
# FIELD_ENCRYPTION_KEY=

# --- Google Maps ------------------------------------------------------------
# Enable on the project: Maps JavaScript API, Geocoding, Directions,
# Distance Matrix, Places.
#
# TWO keys, and they are not interchangeable:
#
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY  ships to the browser. Restrict it by HTTP
#                                    referrer. Draws the basemap on the family's
#                                    tracking screen.
#   GOOGLE_MAPS_SERVER_KEY           never leaves the server. Restrict it by IP.
#                                    Geocodes addresses and plans routes.
#
# A referrer-restricted key sends no Referer header from a server, so Google
# answers REQUEST_DENIED. Using the public key for both is the single most
# common way this breaks.
#
# Check both with:  npm run verify:maps

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=

# --- Razorpay (UPI Autopay, cards, netbanking) ------------------------------
# Test keys start rzp_test_. Create the webhook in the Razorpay dashboard
# pointing at https://your-domain/api/payments/webhook and subscribe to
# payment.captured, payment.failed, subscription.activated, subscription.charged,
# subscription.halted and subscription.cancelled.

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- ElevenLabs (voice support agent) ---------------------------------------
# An agent has already been created in the workspace:
#
#   name:  SwasthaSetu Sahayak
#   id:    agent_2901m1x6rwtxf4bs8yyz1836r85a
#
# Set both values below to switch the in-app assistant from the simulator to
# the live agent. Every turn still passes through the server-side output guard
# in app/api/voice/turn/route.ts either way.
#
# To recreate or update the agent from source: npm run provision:voice

# ELEVENLABS_API_KEY=
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_2901m1x6rwtxf4bs8yyz1836r85a

# --- ABDM / ABHA ------------------------------------------------------------
# Sandbox credentials come from https://sandbox.abdm.gov.in after registering.
# Production additionally requires M1/M2/M3 milestone certification and Health
# Facility Registry registration — see docs/abdm-go-live.md.

ABDM_ENV="sandbox"
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=

# --- SMS / WhatsApp ---------------------------------------------------------
# Without these, OTPs print to the server console and appear on screen.

# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# --- retention & operating limits -------------------------------------------

# Raw GPS pings are purged after this many days and collapsed to a summary.
PING_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=90
# Collection-to-lab-intake ceiling, in minutes. The hard sample rule.
SAMPLE_CLOCK_MINUTES=120
