<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest. It must match the App Privacy answers in App
  Store Connect (docs/store-launch.md) and the privacy policy (/privacy).
  No tracking. Everything collected is linked to the account and used only
  to provide the service.
-->
