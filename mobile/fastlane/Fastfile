# Store submission for the MEDWYN apps, run by .github/workflows/mobile.yml
# when it is started by hand with "submit" ticked. The one-time setup is in
# docs/store-launch.md. Nothing secret lives here: every key arrives as an
# environment variable from the repository's secrets.
#
#   fastlane ios submit build_number:42 submit_for_review:true
#   fastlane android submit aab:path/to/app-release.aab track:internal release_status:draft

default_platform(:ios)

APP_ID = ENV['MEDWYN_APP_ID'] || 'in.medwyn.app'

# The version people see, from the Xcode project, so both stores show the same one.
def marketing_version
  pbx = File.read(File.expand_path('../ios/App/App.xcodeproj/project.pbxproj', __dir__))
  pbx[/MARKETING_VERSION = ([\d.]+);/, 1] || UI.user_error!('MARKETING_VERSION not found in the Xcode project')
end

def app_url
  ENV.fetch('MEDWYN_APP_URL').chomp('/')
end

# What App Review reads before opening the app. Google Play's "App access"
# section takes the same sign-in steps, typed into Play Console.
def review_notes
  <<~NOTES
    MEDWYN arranges regular home blood-test visits for elderly parents in India. Families book in the app; a trained technician visits, and an NABL-accredited partner laboratory runs the tests and signs the report.

    Signing in: choose Phone, enter the user name above as the mobile number, tap "Send me a code", and enter the password above as the code. No SMS is sent to this number.

    The account has a sample parent whose address is inside our service area. You can browse tests, see the partner labs near that address, choose a time and reach checkout. Please do not complete a payment: it is a real charge for a technician's home visit.

    Payments are for physical services delivered outside the app (a home blood-sample collection and laboratory tests), through Razorpay, as guideline 3.1.5(a) allows. The optional Medwyn One membership only lowers the price of those visits and unlocks no digital content.

    Account deletion: Profile, then "Delete my account".
    Location: used only on the device, to sort labs by distance, when "Use my current location" is tapped. It is never sent to our servers.
    Microphone: only after tapping "Talk to us", for a voice assistant that answers questions about visits. It does not give medical advice.
  NOTES
end

platform :ios do
  desc 'Upload the App Store listing and screenshots, then submit a TestFlight build for review'
  lane :submit do |options|
    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8')
    )
    contact_first, contact_last = ENV.fetch('REVIEW_CONTACT_NAME').strip.split(' ', 2)
    deliver(
      app_identifier: APP_ID,
      app_version: marketing_version,
      build_number: options[:build_number]&.to_s,
      skip_binary_upload: true, # the workflow has already sent it to TestFlight
      metadata_path: 'fastlane/metadata/ios',
      screenshots_path: 'fastlane/screenshots/ios',
      overwrite_screenshots: true,
      force: true, # no HTML preview to approve: this runs on a server
      submit_for_review: options[:submit_for_review].to_s != 'false',
      automatic_release: false, # you press Release once it is approved
      run_precheck_before_submit: false, # precheck cannot read in-app purchases with an API key
      primary_category: 'MEDICAL',
      secondary_category: 'HEALTH_AND_FITNESS',
      copyright: "#{Time.now.year} #{ENV.fetch('LEGAL_ENTITY')}",
      support_url: { 'en-US' => "#{app_url}/support" },
      marketing_url: { 'en-US' => app_url },
      privacy_url: { 'en-US' => "#{app_url}/privacy" },
      app_review_information: {
        first_name: contact_first,
        last_name: contact_last || contact_first,
        phone_number: ENV.fetch('REVIEW_CONTACT_PHONE'),
        email_address: ENV.fetch('REVIEW_CONTACT_EMAIL'),
        demo_user: ENV.fetch('APP_REVIEW_PHONE').delete_prefix('+91'),
        demo_password: ENV.fetch('APP_REVIEW_CODE'),
        notes: review_notes
      },
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end

platform :android do
  desc 'Upload the Play listing, screenshots and a signed bundle to a Google Play track'
  lane :submit do |options|
    upload_to_play_store(
      package_name: APP_ID,
      aab: options.fetch(:aab),
      track: options[:track] || 'internal',
      # Until Google has reviewed the app once, every release must be a draft
      # you send for review in Play Console. After that, 'completed' does it.
      release_status: options[:release_status] || 'draft',
      json_key_data: ENV.fetch('PLAY_SERVICE_ACCOUNT_JSON'),
      metadata_path: 'fastlane/metadata/android'
    )
  end
end
